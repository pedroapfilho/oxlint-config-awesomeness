{
  "name": "oxlint-config-awesomeness",
  "version": "4.9.1",
  "description": "Oxlint config with sensible defaults.",
  "keywords": [
    "autofix",
    "config",
    "defaults",
    "oxlint",
    "strict"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroapfilho/oxlint-config-awesomeness.git"
  },
  "bin": {
    "lint-astro": "./dist/lint-astro.js",
    "oxlint-config-awesomeness": "./dist/init.js"
  },
  "files": [
    "dist",
    "bin/template.ts",
    "anti-slop"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/typescript6.js"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./anti-slop": {
      "types": "./anti-slop/index.d.ts",
      "default": "./anti-slop/index.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./awesomeness": "./dist/awesomeness.js",
    "./shadcn": {
      "types": "./dist/shadcn.d.ts",
      "default": "./dist/shadcn.js"
    },
    "./template": "./bin/template.ts",
    "./typescript6": {
      "types": "./dist/typescript6.d.ts",
      "default": "./dist/typescript6.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage node_modules",
    "lint": "pnpm build && oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:readme": "node scripts/check-readme.mjs",
    "test": "pnpm build && vitest run",
    "test:coverage": "pnpm build && vitest run --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --score",
    "fallow:audit": "fallow audit",
    "prepare": "husky",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.85.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@nkzw/eslint-plugin": "^2.0.0",
    "@shadcn/lint": "0.2.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/parser": "^8.70.1",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.12.1",
    "fallow": "^3.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-plugin-react-doctor": "^0.9.14",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@nkzw/eslint-plugin": "^2.0.0",
    "@shadcn/lint": ">=0.1.0 <0.3.0",
    "@typescript-eslint/parser": "^8.70.1",
    "@typescript/typescript6": "^6.0.2",
    "astro-eslint-parser": "^3.2.0",
    "eslint": "^10.0.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "oxlint": "^1.82.0",
    "oxlint-plugin-react-doctor": "^0.9.13",
    "oxlint-tsgolint": ">=7.0.2001 <8.0.0",
    "typescript": ">=7.0.0 <8.0.0"
  },
  "peerDependenciesMeta": {
    "@shadcn/lint": {
      "optional": true
    },
    "@typescript-eslint/parser": {
      "optional": true
    },
    "@typescript/typescript6": {
      "optional": true
    },
    "astro-eslint-parser": {
      "optional": true
    }
  },
  "lint-staged": {
    "!(*.d).{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxlint"
    ],
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,md}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1"
}
