{
  "name": "oxlint-config-awesomeness",
  "version": "4.5.1",
  "description": "Oxlint config with sensible defaults.",
  "keywords": [
    "autofix",
    "config",
    "defaults",
    "oxlint",
    "strict"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedroapfilho/oxlint-config-awesomeness.git"
  },
  "bin": {
    "oxlint-config-awesomeness": "./dist/init.js"
  },
  "files": [
    "dist",
    "bin/template.ts",
    "anti-slop"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./anti-slop": {
      "types": "./anti-slop/index.d.ts",
      "default": "./anti-slop/index.js"
    },
    "./awesomeness": "./dist/awesomeness.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage node_modules",
    "check:generated": "node scripts/check-generated.mjs",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:readme": "node scripts/check-readme-severities.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --score",
    "fallow:audit": "fallow audit --base main",
    "prepare": "husky",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.79.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@nkzw/eslint-plugin": "^2.0.0",
    "@types/node": "^26.2.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-unused-imports": "~4.4.1",
    "fallow": "^3.22.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-plugin-react-doctor": "^0.9.13",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@nkzw/eslint-plugin": "^2.0.0",
    "eslint-plugin-no-only-tests": "^3.4.0",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-unused-imports": "~4.4.1",
    "oxlint": ">=1.79.0 <2.0.0",
    "oxlint-plugin-react-doctor": "^0.9.11",
    "oxlint-tsgolint": ">=7.0.2001 <8.0.0",
    "typescript": ">=7.0.0 <8.0.0"
  },
  "lint-staged": {
    "!(*.d).{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxlint"
    ],
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,md}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1"
}
